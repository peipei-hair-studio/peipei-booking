    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "netlify-cli": "27.18.0",
